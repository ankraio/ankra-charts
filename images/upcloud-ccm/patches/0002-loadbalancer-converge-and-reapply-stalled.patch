diff --git a/internal/loadbalancer/forwarding.go b/internal/loadbalancer/forwarding.go
new file mode 100644
index 0000000..8ae4cd9
--- /dev/null
+++ b/internal/loadbalancer/forwarding.go
@@ -0,0 +1,211 @@
+package loadbalancer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/UpCloudLtd/upcloud-go-api/v8/upcloud"
+	"github.com/UpCloudLtd/upcloud-go-api/v8/upcloud/request"
+	"github.com/google/uuid"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/util/wait"
+)
+
+const (
+	// forwardingCheckInterval is how often the forwarding monitor reads the
+	// member status of every load balancer the controller manages.
+	forwardingCheckInterval = 2 * time.Minute
+
+	// forwardingStrikesBeforeReapply is how many consecutive checks must find
+	// a backend with no member up before the configuration is reapplied, so
+	// a single health-check transition never triggers one.
+	forwardingStrikesBeforeReapply = 2
+
+	// forwardingReapplyCooldown is the shortest time between two reapplies of
+	// one load balancer. A backend whose members are all genuinely down (the
+	// workload is not running) keeps failing the check, and reapplying it
+	// cannot help, so it is retried at this pace rather than on every check.
+	forwardingReapplyCooldown = 10 * time.Minute
+
+	memberStatusUp = "up"
+)
+
+var errBackendWouldBeEmptied = errors.New("refusing to remove every member from a load balancer backend")
+
+// loadBalancerMetrics is the part of GET /load-balancer/{uuid}/metrics the
+// forwarding monitor reads.
+type loadBalancerMetrics struct {
+	Backends []backendMetrics `json:"backends"`
+}
+
+type backendMetrics struct {
+	Name    string          `json:"name"`
+	Members []memberMetrics `json:"members"`
+}
+
+type memberMetrics struct {
+	Name   string `json:"name"`
+	Status string `json:"status"`
+}
+
+// ForwardingMonitor is implemented by a load balancer manager that can watch
+// its load balancers for a configuration the API accepted but does not
+// forward traffic with, and reapply it.
+type ForwardingMonitor interface {
+	RunForwardingMonitor(ctx context.Context)
+}
+
+type forwardingState struct {
+	strikes       int
+	lastReapplied time.Time
+}
+
+// RunForwardingMonitor checks every managed load balancer until ctx is done.
+//
+// The service controller only reconciles a load balancer when its Service
+// changes, its node set changes or the controller restarts, and a
+// reconcile compares configurations only. A load balancer that holds the
+// right configuration but has stopped forwarding to its members therefore
+// stays broken until something unrelated touches it. The monitor reads the
+// member status the API reports and reapplies the configuration of a load
+// balancer whose backend has members but none of them up.
+func (m *manager) RunForwardingMonitor(ctx context.Context) {
+	states := map[string]*forwardingState{}
+	wait.UntilWithContext(ctx, func(ctx context.Context) {
+		m.checkForwarding(ctx, states, time.Now())
+	}, forwardingCheckInterval)
+}
+
+func (m *manager) checkForwarding(ctx context.Context, states map[string]*forwardingState, now time.Time) {
+	services, listError := m.coreV1Client.Services(v1.NamespaceAll).List(ctx, metav1.ListOptions{})
+	if listError != nil {
+		m.log.Infof("forwarding monitor: listing services failed: %v", listError)
+		return
+	}
+	seen := map[string]bool{}
+	for i := range services.Items {
+		service := &services.Items[i]
+		if !managedLoadBalancerService(service) {
+			continue
+		}
+		loadBalancerUUID := loadBalancerIDFromService(service).String()
+		seen[loadBalancerUUID] = true
+		state, found := states[loadBalancerUUID]
+		if !found {
+			state = &forwardingState{}
+			states[loadBalancerUUID] = state
+		}
+		m.checkServiceForwarding(ctx, service, state, now)
+	}
+	for loadBalancerUUID := range states {
+		if !seen[loadBalancerUUID] {
+			delete(states, loadBalancerUUID)
+		}
+	}
+}
+
+func (m *manager) checkServiceForwarding(ctx context.Context, service *v1.Service, state *forwardingState, now time.Time) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	lb, getError := m.svc.GetLoadBalancer(ctx, m.configuredClusterName(""), service)
+	if getError != nil {
+		m.log.Infof("forwarding monitor: reading load balancer for %s/%s failed: %v", service.Namespace, service.Name, getError)
+		return
+	}
+	if lb.OperationalState != upcloud.LoadBalancerOperationalStateRunning {
+		state.strikes = 0
+		return
+	}
+	metrics, metricsError := m.svc.GetLoadBalancerMetrics(ctx, lb)
+	if metricsError != nil {
+		m.log.Infof("forwarding monitor: reading metrics of load balancer %s failed: %v", lb.Name, metricsError)
+		return
+	}
+	stalled := backendsWithoutServingMembers(lb, metrics)
+	if len(stalled) == 0 {
+		state.strikes = 0
+		return
+	}
+	state.strikes++
+	m.log.Infof("forwarding monitor: load balancer %s backends %s have no member up (check %d)", lb.Name, strings.Join(stalled, ", "), state.strikes)
+	if state.strikes < forwardingStrikesBeforeReapply || now.Sub(state.lastReapplied) < forwardingReapplyCooldown {
+		return
+	}
+	state.lastReapplied = now
+	state.strikes = 0
+	if reapplyError := m.svc.ReapplyLoadBalancer(ctx, lb); reapplyError != nil {
+		m.log.Infof("forwarding monitor: reapplying load balancer %s failed: %v", lb.Name, reapplyError)
+		m.eventRecorder.Event(service, v1.EventTypeWarning, notForwardingEventType,
+			fmt.Sprintf("backends %s have no member up; reapplying the load balancer configuration failed: %v", strings.Join(stalled, ", "), reapplyError))
+		return
+	}
+	m.log.Infof("forwarding monitor: reapplied load balancer %s configuration", lb.Name)
+	m.eventRecorder.Event(service, v1.EventTypeWarning, notForwardingEventType,
+		fmt.Sprintf("backends %s have no member up; reapplied the load balancer configuration", strings.Join(stalled, ", ")))
+}
+
+// managedLoadBalancerService reports whether the service is a LoadBalancer
+// this controller serves and has already been bound to a load balancer.
+func managedLoadBalancerService(service *v1.Service) bool {
+	if service.Spec.Type != v1.ServiceTypeLoadBalancer || service.Spec.LoadBalancerClass != nil {
+		return false
+	}
+	if !service.DeletionTimestamp.IsZero() {
+		return false
+	}
+	return loadBalancerIDFromService(service) != uuid.Nil
+}
+
+// backendsWithoutServingMembers names the backends that have at least one
+// enabled member configured but no member the API reports as up, including a
+// backend the metrics do not mention at all.
+func backendsWithoutServingMembers(lb *upcloud.LoadBalancer, metrics *loadBalancerMetrics) []string {
+	stalled := make([]string, 0)
+	for _, backend := range lb.Backends {
+		if !slices.ContainsFunc(backend.Members, func(member upcloud.LoadBalancerBackendMember) bool { return member.Enabled }) {
+			continue
+		}
+		index := slices.IndexFunc(metrics.Backends, func(candidate backendMetrics) bool { return candidate.Name == backend.Name })
+		if index < 0 {
+			stalled = append(stalled, backend.Name)
+			continue
+		}
+		if !slices.ContainsFunc(metrics.Backends[index].Members, func(member memberMetrics) bool {
+			return strings.EqualFold(member.Status, memberStatusUp)
+		}) {
+			stalled = append(stalled, backend.Name)
+		}
+	}
+	slices.Sort(stalled)
+	return stalled
+}
+
+// backendsEmptiedByUpdate refuses an update that would leave a backend that
+// has members today with none. That only happens when the controller has
+// lost sight of the nodes (an API or informer fault, or a node selector
+// that stopped matching), and pushing it takes a working load balancer
+// down without any error, so the update fails loudly instead and the load
+// balancer keeps forwarding to the members it has.
+func backendsEmptiedByUpdate(lb *upcloud.LoadBalancer, desired *request.CreateLoadBalancerRequest) error {
+	emptied := make([]string, 0)
+	for _, backend := range desired.Backends {
+		if len(backend.Members) > 0 {
+			continue
+		}
+		index := slices.IndexFunc(lb.Backends, func(live upcloud.LoadBalancerBackend) bool { return live.Name == backend.Name })
+		if index >= 0 && len(lb.Backends[index].Members) > 0 {
+			emptied = append(emptied, backend.Name)
+		}
+	}
+	if len(emptied) == 0 {
+		return nil
+	}
+	slices.Sort(emptied)
+	return fmt.Errorf("%w: backends %s would have no members; check the node selectors and that the nodes are registered", errBackendWouldBeEmptied, strings.Join(emptied, ", "))
+}
diff --git a/internal/loadbalancer/forwarding_internal_test.go b/internal/loadbalancer/forwarding_internal_test.go
new file mode 100644
index 0000000..32c3ba0
--- /dev/null
+++ b/internal/loadbalancer/forwarding_internal_test.go
@@ -0,0 +1,339 @@
+package loadbalancer
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/UpCloudLtd/upcloud-cloud-controller-manager/internal/logger"
+	"github.com/UpCloudLtd/upcloud-cloud-controller-manager/internal/mock"
+	"github.com/UpCloudLtd/upcloud-go-api/v8/upcloud"
+	"github.com/UpCloudLtd/upcloud-go-api/v8/upcloud/request"
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/require"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/tools/record"
+)
+
+const traefikConfigAnnotation = `{"frontends": [{"name": "web", "mode": "tcp", "port": 80}, {"name": "websecure", "mode": "tcp", "port": 443}], "backends": [{"name": "web", "properties": {"outbound_proxy_protocol": "v2"}}, {"name": "websecure", "properties": {"outbound_proxy_protocol": "v2"}}]}`
+
+func traefikService(annotation string) *v1.Service {
+	return &v1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:        "traefik",
+			Namespace:   "traefik",
+			Annotations: map[string]string{loadBalancerConfigAnnotation: annotation},
+		},
+		Spec: v1.ServiceSpec{
+			Type: v1.ServiceTypeLoadBalancer,
+			Ports: []v1.ServicePort{
+				{Name: "web", Port: 80, NodePort: 31077},
+				{Name: "websecure", Port: 443, NodePort: 30958},
+			},
+		},
+	}
+}
+
+func workerNodes(addresses ...string) []*v1.Node {
+	nodes := make([]*v1.Node, 0, len(addresses))
+	for index, address := range addresses {
+		nodes = append(nodes, &v1.Node{
+			ObjectMeta: metav1.ObjectMeta{Name: "worker-" + string(rune('a'+index))},
+			Status:     v1.NodeStatus{Addresses: []v1.NodeAddress{{Type: v1.NodeInternalIP, Address: address}}},
+		})
+	}
+	return nodes
+}
+
+func desiredTraefikRequest(t *testing.T, annotation string, nodes []*v1.Node) *request.CreateLoadBalancerRequest {
+	t.Helper()
+	plan := upcloud.LoadBalancerPlan{Name: DefaultPlan, PerServerMaxSessions: 1000}
+	service := traefikService(annotation)
+	desired, buildError := createLoadBalancerRequest(service, nodes, plan, "network-uuid", "lb-name", "fi-hel2", nil)
+	require.NoError(t, buildError)
+	desired.Labels = createLoadBalancerRequestLabels(service, "cluster-id", "cluster", "lb-name")
+	require.NoError(t, mergeLoadBalancerConfigFromServiceAnnotations(service, desired, map[string]upcloud.LoadBalancerPlan{DefaultPlan: plan}))
+	return desired
+}
+
+// apiDefaultedBackendProperties is what the API holds for a backend created
+// with only outbound_proxy_protocol set: every other property at its default.
+func apiDefaultedBackendProperties() *upcloud.LoadBalancerBackendProperties {
+	disabled := false
+	return &upcloud.LoadBalancerBackendProperties{
+		TimeoutServer:             10,
+		TimeoutTunnel:             3600,
+		HealthCheckType:           upcloud.LoadBalancerHealthCheckTypeTCP,
+		HealthCheckInterval:       10,
+		HealthCheckFall:           3,
+		HealthCheckRise:           3,
+		HealthCheckURL:            "/",
+		HealthCheckExpectedStatus: 200,
+		OutboundProxyProtocol:     "v2",
+		TLSEnabled:                &disabled,
+		TLSVerify:                 &disabled,
+		TLSUseSystemCA:            &disabled,
+		HTTP2Enabled:              &disabled,
+		HealthCheckTLSVerify:      &disabled,
+	}
+}
+
+// liveLoadBalancer renders a desired request the way the API returns it.
+func liveLoadBalancer(desired *request.CreateLoadBalancerRequest) *upcloud.LoadBalancer {
+	lb := &upcloud.LoadBalancer{
+		UUID:             uuid.NewString(),
+		Name:             desired.Name,
+		Plan:             desired.Plan,
+		Zone:             desired.Zone,
+		ConfiguredStatus: desired.ConfiguredStatus,
+		OperationalState: upcloud.LoadBalancerOperationalStateRunning,
+		Labels:           desired.Labels,
+	}
+	for _, network := range desired.Networks {
+		lb.Networks = append(lb.Networks, upcloud.LoadBalancerNetwork{Name: network.Name, Type: network.Type, Family: network.Family, UUID: network.UUID})
+	}
+	for _, frontend := range desired.Frontends {
+		lb.Frontends = append(lb.Frontends, upcloud.LoadBalancerFrontend{
+			Name: frontend.Name, Mode: frontend.Mode, Port: frontend.Port, DefaultBackend: frontend.DefaultBackend,
+			Rules: []upcloud.LoadBalancerFrontendRule{}, TLSConfigs: []upcloud.LoadBalancerFrontendTLSConfig{},
+			Properties: frontend.Properties, Networks: frontend.Networks,
+		})
+	}
+	for _, backend := range desired.Backends {
+		live := upcloud.LoadBalancerBackend{Name: backend.Name, Properties: apiDefaultedBackendProperties(), TLSConfigs: []upcloud.LoadBalancerBackendTLSConfig{}}
+		for _, member := range backend.Members {
+			live.Members = append(live.Members, upcloud.LoadBalancerBackendMember{
+				Name: member.Name, IP: member.IP, Port: member.Port, Weight: member.Weight,
+				MaxSessions: member.MaxSessions, Type: member.Type, Enabled: member.Enabled,
+			})
+		}
+		lb.Backends = append(lb.Backends, live)
+	}
+	return lb
+}
+
+func TestPartialBackendPropertiesCompareEqualToTheLiveLoadBalancer(t *testing.T) {
+	t.Parallel()
+
+	nodes := workerNodes("10.17.185.5", "10.17.185.6", "10.17.185.7")
+	live := liveLoadBalancer(desiredTraefikRequest(t, traefikConfigAnnotation, nodes))
+
+	// A fresh desired request, as a newly elected leader builds it.
+	require.NoError(t, createLoadBalancerRequestsEqual(loadBalancerToCreateRequest(live), desiredTraefikRequest(t, traefikConfigAnnotation, nodes)))
+}
+
+func TestPartialBackendPropertiesKeepTheDefaults(t *testing.T) {
+	t.Parallel()
+
+	desired := desiredTraefikRequest(t, `{"backends": [{"name": "web", "properties": {"outbound_proxy_protocol": "v2", "tls_enabled": true}}]}`, workerNodes("10.0.0.1"))
+	var web *request.LoadBalancerBackend
+	for index := range desired.Backends {
+		if desired.Backends[index].Name == "web" {
+			web = &desired.Backends[index]
+		}
+	}
+	require.NotNil(t, web)
+	require.Equal(t, upcloud.LoadBalancerProxyProtocolVersion("v2"), web.Properties.OutboundProxyProtocol)
+	require.Equal(t, 10, web.Properties.TimeoutServer)
+	require.Equal(t, 3600, web.Properties.TimeoutTunnel)
+	require.Equal(t, upcloud.LoadBalancerHealthCheckTypeTCP, web.Properties.HealthCheckType)
+	require.True(t, *web.Properties.TLSEnabled)
+	// The defaults share one *bool between fields; setting one must not set the others.
+	require.False(t, *web.Properties.TLSVerify)
+	require.False(t, *web.Properties.HTTP2Enabled)
+	require.Len(t, web.Members, 1)
+}
+
+func TestPartialFrontendPropertiesKeepTheDefaults(t *testing.T) {
+	t.Parallel()
+
+	desired := desiredTraefikRequest(t, `{"frontends": [{"name": "web", "properties": {"inbound_proxy_protocol": true}}]}`, workerNodes("10.0.0.1"))
+	var web *request.LoadBalancerFrontend
+	for index := range desired.Frontends {
+		if desired.Frontends[index].Name == "web" {
+			web = &desired.Frontends[index]
+		}
+	}
+	require.NotNil(t, web)
+	require.True(t, *web.Properties.InboundProxyProtocol)
+	require.Equal(t, 10, web.Properties.TimeoutClient)
+	require.False(t, *web.Properties.HTTP2Enabled)
+}
+
+func TestUnnamedSingleBackendPropertiesKeepTheDefaults(t *testing.T) {
+	t.Parallel()
+
+	plan := upcloud.LoadBalancerPlan{Name: DefaultPlan, PerServerMaxSessions: 1000}
+	service := traefikService(`{"backends": [{"properties": {"timeout_server": 30}}]}`)
+	service.Spec.Ports = service.Spec.Ports[:1]
+	desired, buildError := createLoadBalancerRequest(service, workerNodes("10.0.0.1"), plan, "network-uuid", "lb-name", "fi-hel2", nil)
+	require.NoError(t, buildError)
+	require.NoError(t, mergeLoadBalancerConfigFromServiceAnnotations(service, desired, map[string]upcloud.LoadBalancerPlan{DefaultPlan: plan}))
+	require.Len(t, desired.Backends, 1)
+	require.Equal(t, "web", desired.Backends[0].Name)
+	require.Equal(t, 30, desired.Backends[0].Properties.TimeoutServer)
+	require.Equal(t, 3600, desired.Backends[0].Properties.TimeoutTunnel)
+}
+
+func TestBackendsEmptiedByUpdate(t *testing.T) {
+	t.Parallel()
+
+	nodes := workerNodes("10.17.185.5", "10.17.185.6")
+	live := liveLoadBalancer(desiredTraefikRequest(t, traefikConfigAnnotation, nodes))
+
+	require.NoError(t, backendsEmptiedByUpdate(live, desiredTraefikRequest(t, traefikConfigAnnotation, nodes)))
+	require.NoError(t, backendsEmptiedByUpdate(live, desiredTraefikRequest(t, traefikConfigAnnotation, workerNodes("10.17.185.9"))))
+
+	emptiedError := backendsEmptiedByUpdate(live, desiredTraefikRequest(t, traefikConfigAnnotation, nil))
+	require.ErrorIs(t, emptiedError, errBackendWouldBeEmptied)
+	require.Contains(t, emptiedError.Error(), "web, websecure")
+
+	empty := liveLoadBalancer(desiredTraefikRequest(t, traefikConfigAnnotation, nil))
+	require.NoError(t, backendsEmptiedByUpdate(empty, desiredTraefikRequest(t, traefikConfigAnnotation, nil)))
+}
+
+func TestBackendsWithoutServingMembers(t *testing.T) {
+	t.Parallel()
+
+	live := liveLoadBalancer(desiredTraefikRequest(t, traefikConfigAnnotation, workerNodes("10.0.0.1", "10.0.0.2")))
+	metrics := func(webStatuses, websecureStatuses []string) *loadBalancerMetrics {
+		backend := func(name string, statuses []string) backendMetrics {
+			result := backendMetrics{Name: name}
+			for _, status := range statuses {
+				result.Members = append(result.Members, memberMetrics{Name: "member", Status: status})
+			}
+			return result
+		}
+		return &loadBalancerMetrics{Backends: []backendMetrics{backend("web", webStatuses), backend("websecure", websecureStatuses)}}
+	}
+
