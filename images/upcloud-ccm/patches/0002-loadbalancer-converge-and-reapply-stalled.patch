+package loadbalancer
+
+import (
+	"encoding/json"
+
+	"github.com/UpCloudLtd/upcloud-go-api/v8/upcloud"
+)
+
+// annotationProperties holds the raw properties objects the config annotation
+// sets on its backends and frontends.
+//
+// The annotation is decoded into the request types, where a field it leaves
+// out and a field it sets to its zero value look the same. Keeping the raw
+// objects lets the controller lay exactly the fields the annotation names
+// over the defaults. Without that, an annotation that sets one property (for
+// example `{"outbound_proxy_protocol": "v2"}`) replaced every default with a
+// zero value. The API then filled its own defaults in, the live load balancer
+// never compared equal to the desired one, and every leader change re-sent the
+// whole load balancer configuration to the API.
+type annotationProperties struct {
+	Backends  []namedRawProperties `json:"backends"`
+	Frontends []namedRawProperties `json:"frontends"`
+}
+
+type namedRawProperties struct {
+	Name       string          `json:"name"`
+	Properties json.RawMessage `json:"properties"`
+}
+
+// rawPropertiesFor answers the raw properties the annotation set on the named
+// item. A config with a single unnamed item takes the default item's name, so
+// that item is matched by its empty name.
+func rawPropertiesFor(overrides []namedRawProperties, name string, itemCount int) json.RawMessage {
+	for _, override := range overrides {
+		if override.Name == name {
+			return override.Properties
+		}
+	}
+	if itemCount == 1 && len(overrides) == 1 && overrides[0].Name == "" {
+		return overrides[0].Properties
+	}
+	return nil
+}
+
+// overlayBackendProperties returns a copy of the defaults with the fields the
+// raw object sets written over them.
+func overlayBackendProperties(defaults *upcloud.LoadBalancerBackendProperties, raw json.RawMessage) (*upcloud.LoadBalancerBackendProperties, error) {
+	merged := *defaults
+	merged.HealthCheckTLSVerify = cloneBool(defaults.HealthCheckTLSVerify)
+	merged.TLSEnabled = cloneBool(defaults.TLSEnabled)
+	merged.TLSVerify = cloneBool(defaults.TLSVerify)
+	merged.TLSUseSystemCA = cloneBool(defaults.TLSUseSystemCA)
+	merged.HTTP2Enabled = cloneBool(defaults.HTTP2Enabled)
+	if unmarshalError := json.Unmarshal(raw, &merged); unmarshalError != nil {
+		return nil, unmarshalError
+	}
+	return &merged, nil
+}
+
+// overlayFrontendProperties returns a copy of the defaults with the fields the
+// raw object sets written over them.
+func overlayFrontendProperties(defaults *upcloud.LoadBalancerFrontendProperties, raw json.RawMessage) (*upcloud.LoadBalancerFrontendProperties, error) {
+	merged := *defaults
+	merged.InboundProxyProtocol = cloneBool(defaults.InboundProxyProtocol)
+	merged.HTTP2Enabled = cloneBool(defaults.HTTP2Enabled)
+	if unmarshalError := json.Unmarshal(raw, &merged); unmarshalError != nil {
+		return nil, unmarshalError
+	}
+	return &merged, nil
+}
+
+// cloneBool copies a *bool so that decoding into the copy cannot write
+// through to a value the defaults share between several fields.
+func cloneBool(value *bool) *bool {
+	if value == nil {
+		return nil
+	}
+	copied := *value
+	return &copied
+}
