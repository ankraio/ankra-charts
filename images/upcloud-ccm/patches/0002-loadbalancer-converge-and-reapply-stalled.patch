+func TestForwardingMonitorReappliesAStalledLoadBalancer(t *testing.T) {
+	t.Parallel()
+
+	ctx := context.Background()
+	live := liveLoadBalancer(desiredTraefikRequest(t, traefikConfigAnnotation, workerNodes("10.0.0.1")))
+	stalled := &loadBalancerMetrics{}
+	serving := &loadBalancerMetrics{Backends: []backendMetrics{
+		{Name: "web", Members: []memberMetrics{{Name: "worker-a", Status: "up"}}},
+		{Name: "websecure", Members: []memberMetrics{{Name: "worker-a", Status: "up"}}},
+	}}
+	fake := &fakeForwardingService{loadBalancer: live, metrics: stalled}
+	recorder := record.NewFakeRecorder(10)
+	cli := mock.NewControllerClientBuilder().ClientOrDie("test-client")
+	m := &manager{svc: fake, coreV1Client: cli.CoreV1(), eventRecorder: recorder, config: NewConfig("cluster-id", "cluster", DefaultPlan, 10, ""), log: logger.NewKlog()}
+
+	service := traefikService(traefikConfigAnnotation)
+	service.Annotations[loadBalancerIDAnnotation] = live.UUID
+	_, createError := cli.CoreV1().Services(service.Namespace).Create(ctx, service, metav1.CreateOptions{})
+	require.NoError(t, createError)
+	unmanaged := traefikService(traefikConfigAnnotation)
+	unmanaged.Name = "not-bound-yet"
+	_, createError = cli.CoreV1().Services(unmanaged.Namespace).Create(ctx, unmanaged, metav1.CreateOptions{})
+	require.NoError(t, createError)
+
+	states := map[string]*forwardingState{}
+	start := time.Date(2026, 11, 15, 11, 26, 0, 0, time.UTC)
+
+	m.checkForwarding(ctx, states, start)
+	require.Equal(t, 0, fake.reapplied, "one failed check is not enough")
+
+	m.checkForwarding(ctx, states, start.Add(forwardingCheckInterval))
+	require.Equal(t, 1, fake.reapplied)
+	require.Contains(t, <-recorder.Events, notForwardingEventType)
+
+	m.checkForwarding(ctx, states, start.Add(2*forwardingCheckInterval))
+	m.checkForwarding(ctx, states, start.Add(3*forwardingCheckInterval))
+	require.Equal(t, 1, fake.reapplied, "reapplies are held to the cooldown")
+
+	m.checkForwarding(ctx, states, start.Add(forwardingCheckInterval+forwardingReapplyCooldown))
+	require.Equal(t, 2, fake.reapplied)
+	<-recorder.Events
+
+	fake.metrics = serving
+	m.checkForwarding(ctx, states, start.Add(time.Hour))
+	require.Zero(t, states[live.UUID].strikes)
+
+	fake.metrics = stalled
+	live.OperationalState = upcloud.LoadBalancerOperationalStateSetupLB
+	m.checkForwarding(ctx, states, start.Add(2*time.Hour))
+	m.checkForwarding(ctx, states, start.Add(3*time.Hour))
+	require.Equal(t, 2, fake.reapplied, "a load balancer that is not running is left to the API")
+
+	live.OperationalState = upcloud.LoadBalancerOperationalStateRunning
+	fake.metricsError = errors.New("metrics unavailable")
+	m.checkForwarding(ctx, states, start.Add(4*time.Hour))
+	m.checkForwarding(ctx, states, start.Add(5*time.Hour))
+	require.Equal(t, 2, fake.reapplied, "unreadable metrics never trigger a reapply")
+	require.Len(t, states, 1)
+}
