{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "isms-builder values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hardening",
    "image",
    "server",
    "storage",
    "persistence",
    "networkPolicy",
    "podSecurityContext",
    "securityContext"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "hardening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowInlineSecrets": { "type": "boolean" },
        "allowMutableImageTag": { "type": "boolean" },
        "allowPrivilegedRuntime": { "type": "boolean" },
        "allowUnrestrictedNetwork": { "type": "boolean" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["Recreate", "RollingUpdate"] }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "jwtExpiresIn": { "type": "string" },
        "publicUrl": { "type": "string" },
        "trustProxy": { "type": ["string", "integer"] }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": { "type": "string", "enum": ["json", "sqlite", "postgres", "mariadb"] },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": ["string", "integer"] },
            "name": { "type": "string" },
            "user": { "type": "string" },
            "ssl": { "type": "boolean" }
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": ["string", "integer"] },
        "from": { "type": "string" },
        "secure": { "type": "boolean" },
        "user": { "type": "string" }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object" }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": { "type": "object" }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "properties": {
        "existingSecret": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiVersion": { "type": "string" },
        "name": { "type": "string" },
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] },
            "name": { "type": "string" }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "creationPolicy": { "type": "string" },
            "deletionPolicy": { "type": "string" },
            "template": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string" },
                "metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "annotations": { "type": "object" },
                    "labels": { "type": "object" }
                  }
                }
              }
            }
          }
        },
        "data": { "type": "array", "items": { "type": "object" } },
        "dataFrom": { "type": "array", "items": { "type": "object" } },
        "annotations": { "type": "object" },
        "labels": { "type": "object" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "internalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDns": { "type": "boolean" },
        "dnsNamespace": { "type": "string" },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowSameNamespace": { "type": "boolean" },
            "allowedNamespaces": { "type": "array", "items": { "type": "string" } },
            "extra": { "type": "array", "items": { "type": "object" } }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowSameNamespace": { "type": "boolean" },
            "extra": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string" },
        "annotations": { "type": "object" },
        "retain": { "type": "boolean" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": { "type": "object" },
        "readiness": { "type": "object" },
        "startup": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": true
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podAnnotations": { "type": "object" },
    "deploymentAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "enableServiceLinks": { "type": "boolean" },
    "hostUsers": { "type": ["boolean", "null"] },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": true
    },
    "writableVolumes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tmp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": { "type": "string" }
          }
        }
      }
    },
    "priorityClassName": { "type": "string" },
    "runtimeClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraInitContainers": { "type": "array", "items": { "type": "object" } },
    "extraContainers": { "type": "array", "items": { "type": "object" } },
    "extraObjects": { "type": "array", "items": { "type": "object" } }
  }
}
